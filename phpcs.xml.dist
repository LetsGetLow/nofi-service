<?xml version="1.0"?>
<ruleset name="nofi-service">
    <description>PHP coding standard for nofi-service.</description>

    <file>src</file>
    <file>tests</file>
    <file>migrations</file>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>

    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>
</ruleset>
