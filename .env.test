# define your env variables for the test env here
KERNEL_CLASS='Nofi\Kernel'
APP_SECRET='$ecretf0rt3st'
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"

###> lexik/jwt-authentication-bundle ###
# Throwaway keypair generated by tests/bootstrap.php into var/. Not a secret:
# it signs nothing outside the test suite, and var/ is gitignored.
JWT_SECRET_KEY=%kernel.project_dir%/var/jwt-test/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/var/jwt-test/public.pem
JWT_PASSPHRASE=testing
###< lexik/jwt-authentication-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###
