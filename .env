# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> host ports ###
# The ports the application is reached on. Used by compose.yaml for the port
# mapping and handed to Caddy, which listens on them and builds its HTTP to
# HTTPS redirect from them, so host and container use the same number. Set
# 80 and 443 for a deployment that serves the standard ports. A changed
# mapping needs the container recreated: "docker compose up -d", not restart.
HTTP_PORT=8080
HTTPS_PORT=8443
###< host ports ###

###> php runtime limits ###
# Largest request body PHP accepts. Enforced by PHP before any application
# code runs: an oversized body is discarded, so the caller sees a
# deserialisation error rather than the attachment validation message.
#
# Attachments travel base64 encoded in the JSON body, which inflates them by a
# third, so this must stay above
# SendNotificationDto::MAX_TOTAL_ATTACHMENT_BYTES x 4/3 plus room for the
# message and recipients — 5 MiB of files is nearly 7 MiB on the wire. Leaving
# headroom is deliberate: the application limit is the one that answers with a
# readable violation, so it should be what callers hit first.
#
# Read by PHP, not by Symfony, so a changed value needs the container
# recreated: "docker compose up -d", not restart.
PHP_POST_MAX_SIZE=32M

# Memory one request may use. PHP's own default, so raising PHP_POST_MAX_SIZE
# without raising this buys a body PHP accepts and then cannot decode: the
# request dies with "Allowed memory size exhausted" rather than a refusal.
# FrankenPHP serves in worker mode, so the booted application counts against
# it too.
#
# The workers are sized separately: MESSENGER_MEMORY_LIMIT below is the
# threshold at which one exits and Compose restarts it, and it wants to stay
# under this number so a worker retires deliberately instead of hitting PHP's
# limit and dying mid-message.
PHP_MEMORY_LIMIT=128M

# The same ceiling for a messenger worker, which is a different job: it holds
# the attachments of the message it is delivering, and it is long running, so
# it is given more room than a single request gets.
#
# Keep it above MESSENGER_MEMORY_LIMIT below. That one is a threshold the
# worker checks between messages and then exits cleanly for Compose to restart
# it; this one is PHP's hard limit, which kills the process where it stands.
# Sized the wrong way round, the graceful mechanism never gets to run.
#
# The gap between them has to cover what one message adds *after* the check
# passed, because nothing looks again until it is delivered. Measured on a send
# at the 5 MiB attachment cap: about 52 MiB, the payload being resident four
# times over — raw, base64 in the queue row, decoded by the worker, and base64
# again in the MIME body. 96 MiB of margin is therefore a little under twice
# the worst case. Raising the attachment cap scales this.
PHP_WORKER_MEMORY_LIMIT=256M
###< php runtime limits ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=https://localhost:${HTTPS_PORT}
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
POSTGRES_VERSION=16
POSTGRES_DB=nofi
POSTGRES_USER=nofi
# Set in .env.local for local development, or as a real environment
# variable in every deployed environment. Never commit a value here.
POSTGRES_PASSWORD=
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}?serverVersion=${POSTGRES_VERSION}&charset=utf8"
#DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:54321/${POSTGRES_DB}?serverVersion=${POSTGRES_VERSION}&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Set in .env.local for local development, or as a real environment
# variable in every deployed environment. Never commit a value here.
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

###> symfony/messenger ###
MESSENGER_NUM_WORKERS=8
# Memory a worker may use before it exits and is restarted by Compose. Read by
# compose.yaml only. A single send holds its attachments in memory, so raise it
# whenever the attachment limits go up: MAX_TOTAL_ATTACHMENT_BYTES, a constant
# in src/Dto/SendNotificationDto.php, and PHP_POST_MAX_SIZE above.
MESSENGER_MEMORY_LIMIT=160M
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> sentry/sentry-symfony ###
# Empty disables Sentry. Set the full DSN in .env.local or as an environment
# variable; composing it from parts yielded an invalid DSN when they were
# unset, which stopped the prod container from building at all.
# Format: https://<public-key>@sentry.example.com/<project-id>
SENTRY_DSN=
###< sentry/sentry-symfony ###

###< Firebase Configuration (file from protected folder) ###
FIREBASE_CREDENTIALS_FILE=config/firebase/credentials.json
